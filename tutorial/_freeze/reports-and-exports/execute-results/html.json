14.739\",\"7.661\",\"7.98\",\"3.14\",\"7.479\",\"2.074\",\"18.853\",\"6.468\",\"7.335\",\"7.727\",\"0.41\",\"0.101\",\"2.912\",\"3.048\",\"4.024\",\"0.06\",\"13.251\",\"0.375\",\"10.828\",\"3.46\",\"19.579\",\"9.425\",\"6.842\"],[\"0.946\",\"0.933\",\"0.902\",\"0.918\",\"0.945\",\"0.94\",\"0.972\",\"0.994\",\"0.923\",\"0.912\",\"0.987\",\"0.934\",\"0.907\",\"0.939\",\"0.928\",\"0.917\",\"0.931\",\"0.923\",\"0.917\",\"0.928\",\"0.999\",\"0.883\",\"0.917\",\"0.951\",\"0.996\"],[\"linear-1\",\"linear-1\",\"linear-1/x\",\"quadratic-1/x\",\"linear-1\",\"linear-1\",\"linear-1\",\"quadratic-1/x\",\"linear-1/x\",\"linear-1/x2\",\"linear-1/x\",\"linear-1\",\"linear-1/x\",\"linear-1/x\",\"linear-1/x\",\"linear-1\",\"linear-1/x\",\"linear-1/x\",\"linear-1\",\"quadratic-1/x\",\"linear-1\",\"linear-1/x\",\"linear-1/x\",\"linear-1/x\",\"linear-1\"],[\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\"],[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"],[\"0.01\",\"0.5\",\"10.793\",\"0.01\",\"0.2\",\"0.25\",\"0.1\",\"0.005\",\"5\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.25\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"],[\"0.02\",\"0.5\",\"11.432\",\"0.01\",\"0.887\",\"0.25\",\"0.1\",\"0.005\",\"5\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.25\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"],[\"0.02\",\"0.5\",\"10.057\",\"0.01\",\"0.2\",\"0.25\",\"0.1\",\"0.005\",\"73.55\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.25\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"],[\"0.02\",\"0.5\",\"14.063\",\"0.01\",\"0.1\",\"0.25\",\"0.1\",\"0.005\",\"5\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.5\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Chemical<\\/th>\\n      <th>LOD<\\/th>\\n      <th>LLOQ<\\/th>\\n      <th>ULOQ<\\/th>\\n      <th>Min Conc.<\\/th>\\n      <th>Max Conc.<\\/th>\\n      <th>Avg. Conc.<\\/th>\\n      <th>Median Conc.<\\/th>\\n      <th>R2<\\/th>\\n      <th>Model<\\/th>\\n      <th>Calibration<\\/th>\\n      <th>Notes<\\/th>\\n      <th>PROCBLK2_B1_43<\\/th>\\n      <th>PROCBLK4_B1_70<\\/th>\\n      <th>PROCBLK4_B1_84<\\/th>\\n      <th>PROCBLK2_B1_99<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"scrollX\":true,\"scrollY\":\"380px\",\"scrollCollapse\":true,\"columnDefs\":[{\"className\":\"dt-center\",\"targets\":\"_all\"},{\"name\":\"Chemical\",\"targets\":0},{\"name\":\"LOD\",\"targets\":1},{\"name\":\"LLOQ\",\"targets\":2},{\"name\":\"ULOQ\",\"targets\":3},{\"name\":\"Min Conc.\",\"targets\":4},{\"name\":\"Max Conc.\",\"targets\":5},{\"name\":\"Avg. Conc.\",\"targets\":6},{\"name\":\"Median Conc.\",\"targets\":7},{\"name\":\"R2\",\"targets\":8},{\"name\":\"Model\",\"targets\":9},{\"name\":\"Calibration\",\"targets\":10},{\"name\":\"Notes\",\"targets\":11},{\"name\":\"PROCBLK2_B1_43\",\"targets\":12},{\"name\":\"PROCBLK4_B1_70\",\"targets\":13},{\"name\":\"PROCBLK4_B1_84\",\"targets\":14},{\"name\":\"PROCBLK2_B1_99\",\"targets\":15}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false}},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n**How to read it**\n\n- **Sheets**: *Full* has one row per compound over all batches (average and median of the measured\n  values, the curve used per batch); then one sheet per batch with its limits, statistics, model\n  and **Notes**, the full text of the note icons of table 4.2.\n- **Statistics** (minimum, maximum, average, median) use the measured values of the study samples\n  only: values replaced by the LOD/LLOQ rules are left out.\n- **Coloured cells** in the sample columns are values that were replaced or are above the ULOQ;\n  the last sheet, *Legend*, explains the colours:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"datatables html-widget html-fill-item\" id=\"htmlwidget-26b0c5aecbe783016ef9\" style=\"width:100%;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-26b0c5aecbe783016ef9\">{\"x\":{\"filter\":\"none\",\"vertical\":false,\"data\":[[\"\",\"\",\"\",\"\",\"\"],[\"Not detected (signal below the LOD signal): replaced by LLOQ/4\",\"Detected, not quantified (signal from the LOD signal to below the mean signal of the LLOQ level): replaced by LLOQ/2\",\"Signal at or above the LLOQ level, concentration below the LLOQ: set to the LLOQ\",\"Above the ULOQ (the top of the linear range), within the curve (not replaced)\",\"Above the ULOQ and the highest calibration level of the curve: extrapolated (not replaced)\"]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Colour<\\/th>\\n      <th>Meaning<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"ordering\":false,\"columnDefs\":[{\"name\":\"Colour\",\"targets\":0},{\"name\":\"Meaning\",\"targets\":1}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false,\"rowCallback\":\"function(row, data, displayNum, displayIndex, dataIndex) {\\nvar value=data[0]; $(this.api().cell(row, 0).node()).css({'background-color':$.inArray(dataIndex + 1, [1]) >= 0 ? \\\"#FAAFAF\\\" : $.inArray(dataIndex + 1, [2]) >= 0 ? \\\"#FCEACF\\\" : $.inArray(dataIndex + 1, [3]) >= 0 ? \\\"#D3EBF2\\\" : $.inArray(dataIndex + 1, [4]) >= 0 ? \\\"#E3E0B8\\\" : $.inArray(dataIndex + 1, [5]) >= 0 ? \\\"#A8A05A\\\" : null});\\n}\"}},\"evals\":[\"options.rowCallback\"],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n## Processing history\n\nSome steps of the processing cannot always be done the usual way, for example a batch without blank\nsamples or a compound without a valid calibration curve in its batch. QuaNTA then uses a\n**fallback** (e.g. the blank of all batches, or the global curve) and logs it, as it logs every\nfeature and sample it removes. The same log is shown in three places:\n\n- **In the app**, page 1, the tab *Processing history* next to the processing log: the fallbacks\n  and removals of each step, and the full feature and sample tables in a popup.\n- **In the internal report**, section 1.1, the tabs *Feature flow* (where the features ended),\n  *Fallbacks and removals*, *Feature history* and *Sample history*.\n- **In the exported tables**, the file `….history.xlsx` (each sheet also as a `.csv` file).\n\n\n::: {.cell}\n\n:::\n\n\nThe feature history of the example (QuaNTA_example_ESIpos.mvis.history.xlsx), a few targeted compounds:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"datatables html-widget html-fill-item\" id=\"htmlwidget-7fe3c7d209e2b03fb1f9\" style=\"width:100%;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-7fe3c7d209e2b03fb1f9\">{\"x\":{\"filter\":\"none\",\"vertical\":false,\"data\":[[\"(+)-Nootkatone\",\"1,3-benzothiazole\",\"1,3-Di-o-tolylguanidine\",\"1,3-Diphenylguanidine\",\"1H-Benzimidazole\",\"1H-Benzotriazole\",\"1-Methyl-1H-benzotriazole\",\"2-Hydroxybenzimidazole\",\"3'-Hydroxycotinine\",\"4- &amp; 5-Methyl-1H-benzotriazole\",\"4-(Methylnitrosamino)-1-(3-pyridyl)-1-butanol\",\"4-Methyl Hippuric Acid\",\"5,6-Dimethylbenzimidazole\",\"Aminocaproic acid\",\"Amoxicillin\",\"Arnicolide C\",\"Atenolol\",\"Atorvastatin\",\"Atrazine\",\"Atrazine desethyl\",\"Atrazine desethyl-2-hydroxy\",\"Atrazine desisopropyl\",\"Atrazine-2-hydroxy\",\"Benodanil\",\"Benzenesulfonamide\"],[16572,5569,19717,15351,4330,4395,5433,5510,12539,5435,15027,12644,6785,5299,43438,37469,24441,78009,16038,11806,9367,9893,13289,34998,7847],[\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\"],[13.016,9.436999999999999,8.393000000000001,7.449,5.343,7.041,7.653,6.794,5.164,8.625999999999999,6.263,6.625,8.836,2.048,2.874,10.645,5.299,11.648,10.847,8.613,5.06,7.192,8.956,10.659,10.53],[219.17401,136.02139,240.14929,212.11803,119.06017,120.05536,134.07094,135.05501,193.09694,134.07097,210.12367,194.08105,147.09146,132.10159,366.11121,335.18475,267.17007,559.25891,216.10056,188.06958,170.10332,174.05382,198.13458,323.98737,158.0269],[\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Not quantified\",\"Quantified\",\"Not quantified\",\"Quantified\",\"Not quantified\",\"Not quantified\",\"Quantified\",\"Not quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\"],[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"],[\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\"],[\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\"],[\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\",\"Not applied\"],[\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Batch curve\",\"Not quantified: Only 2 calibration level(s) from the LLOQ upwards (minimum 3)\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Not quantified: No calibration level above the LLOQ signal\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Not quantified: No calibration level above the LLOQ signal with RSD% &lt;= 20%\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Global curve (Only 2 calibration level(s) from the LLOQ upwards (minimum 3) in the batch); not exported (no study sample above the LLOQ)\"],[\"Batch curve\",\"Not quantified: Only 2 calibration level(s) from the LLOQ upwards (minimum 3)\",\"Batch curve\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Batch curve\",\"Not quantified: Only 1 calibration level(s) from the LLOQ upwards (minimum 3)\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Not quantified: No calibration level above the LLOQ signal\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Not quantified: Only 2 calibration level(s) from the LLOQ upwards (minimum 3)\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve; not exported (no study sample above the LLOQ)\"],[\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Not quantified: No calibration level above the LLOQ signal\",\"Batch curve\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Not quantified: No calibration level above the LLOQ signal\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve; not exported (no study sample above the LLOQ)\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\",\"Batch curve\"],[\"\",\"\",\"\",\"\",\"Batch 2: Full calibration range used (No sample or QC at or above the LLOQ)\",\"\",\"\",\"\",\"\",\"Batch 1: Full calibration range used (No sample or QC at or above the LLOQ)\",\"Batch 1: Full calibration range used (No sample or QC at or above the LLOQ)\",\"\",\"\",\"\",\"Batch 2: Full calibration range used (No sample or QC at or above the LLOQ); Batch 3: Full calibration range used (No sample or QC at or above the LLOQ)\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"Batch 1: Full calibration range used (No sample or QC at or above the LLOQ); Batch 2: Full calibration range used (No sample or QC at or above the LLOQ)\"]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Feature<\\/th>\\n      <th>Alignment ID<\\/th>\\n      <th>Type<\\/th>\\n      <th>RT [min]<\\/th>\\n      <th>m/z<\\/th>\\n      <th>Status<\\/th>\\n      <th>Failed IS check<\\/th>\\n      <th>Normalized by<\\/th>\\n      <th>Blank filter<\\/th>\\n      <th>QC RSD% filter<\\/th>\\n      <th>Calibration, batch 1<\\/th>\\n      <th>Calibration, batch 2<\\/th>\\n      <th>Calibration, batch 3<\\/th>\\n      <th>Notes<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"scrollX\":true,\"scrollY\":\"380px\",\"scrollCollapse\":true,\"columnDefs\":[{\"className\":\"dt-center\",\"targets\":\"_all\"},{\"name\":\"Feature\",\"targets\":0},{\"name\":\"Alignment ID\",\"targets\":1},{\"name\":\"Type\",\"targets\":2},{\"name\":\"RT [min]\",\"targets\":3},{\"name\":\"m/z\",\"targets\":4},{\"name\":\"Status\",\"targets\":5},{\"name\":\"Failed IS check\",\"targets\":6},{\"name\":\"Normalized by\",\"targets\":7},{\"name\":\"Blank filter\",\"targets\":8},{\"name\":\"QC RSD% filter\",\"targets\":9},{\"name\":\"Calibration, batch 1\",\"targets\":10},{\"name\":\"Calibration, batch 2\",\"targets\":11},{\"name\":\"Calibration, batch 3\",\"targets\":12},{\"name\":\"Notes\",\"targets\":13}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false}},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n**How to read it**\n\n- **One row per feature** of the input file, also those removed on the way, with its **Status**:\n  where it ended (e.g. *Quantified*, *Kept*, *Removed (blank filter)*).\n- **A column per step**, in the order of the processing: what the step did with the feature\n  (*Passed*, *Removed* and why, *Not applied*). Empty: the step does not concern the feature, or\n  it was removed before.\n- **Calibration, batch N**: the curve used in each batch, its own or the global one, or why the\n  compound was not quantified there.\n- The sheet **Sample history** does the same for the samples (outliers, vIS correction, replaced\n  IS zeros, the blank subtracted, the calibration of their batch), and **Events** lists every\n  logged event, with its kind: *removed*, *fallback*, *changed* (a value replaced) or *note*.\n\n::: {.callout-tip}\n## Reuse the processing\nSave the settings with **Download settings (.yml)** on page 1. Loading the file later, in the app or\nwith `run_quanta.R` on the command line, processes new data the same way.\n:::\n",
