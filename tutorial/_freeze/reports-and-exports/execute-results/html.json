inear-1/x\",\"linear-1\"],[\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\"],[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"],[\"0.01\",\"0.5\",\"10.793\",\"0.01\",\"0.2\",\"0.25\",\"0.1\",\"0.005\",\"5\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.25\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"],[\"0.02\",\"0.5\",\"11.432\",\"0.01\",\"0.887\",\"0.25\",\"0.1\",\"0.005\",\"5\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.25\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"],[\"0.02\",\"0.5\",\"10.057\",\"0.01\",\"0.2\",\"0.25\",\"0.1\",\"0.005\",\"73.55\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.25\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"],[\"0.02\",\"0.5\",\"14.063\",\"0.01\",\"0.1\",\"0.25\",\"0.1\",\"0.005\",\"5\",\"2.5\",\"0.05\",\"0.02\",\"0.025\",\"0.01\",\"0.5\",\"0.025\",\"0.25\",\"0.01\",\"0.25\",\"0.01\",\"0.013\",\"0.25\",\"2.5\",\"2.5\",\"0.013\"]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Chemical<\\/th>\\n      <th>LOD<\\/th>\\n      <th>LLOQ<\\/th>\\n      <th>ULOQ<\\/th>\\n      <th>Min Conc.<\\/th>\\n      <th>Max Conc.<\\/th>\\n      <th>Avg. Conc.<\\/th>\\n      <th>Median Conc.<\\/th>\\n      <th>R2<\\/th>\\n      <th>Model<\\/th>\\n      <th>Calibration<\\/th>\\n      <th>Notes<\\/th>\\n      <th>PROCBLK2_B1_43<\\/th>\\n      <th>PROCBLK4_B1_70<\\/th>\\n      <th>PROCBLK4_B1_84<\\/th>\\n      <th>PROCBLK2_B1_99<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"scrollX\":true,\"scrollY\":\"380px\",\"scrollCollapse\":true,\"columnDefs\":[{\"className\":\"dt-center\",\"targets\":\"_all\"},{\"name\":\"Chemical\",\"targets\":0},{\"name\":\"LOD\",\"targets\":1},{\"name\":\"LLOQ\",\"targets\":2},{\"name\":\"ULOQ\",\"targets\":3},{\"name\":\"Min Conc.\",\"targets\":4},{\"name\":\"Max Conc.\",\"targets\":5},{\"name\":\"Avg. Conc.\",\"targets\":6},{\"name\":\"Median Conc.\",\"targets\":7},{\"name\":\"R2\",\"targets\":8},{\"name\":\"Model\",\"targets\":9},{\"name\":\"Calibration\",\"targets\":10},{\"name\":\"Notes\",\"targets\":11},{\"name\":\"PROCBLK2_B1_43\",\"targets\":12},{\"name\":\"PROCBLK4_B1_70\",\"targets\":13},{\"name\":\"PROCBLK4_B1_84\",\"targets\":14},{\"name\":\"PROCBLK2_B1_99\",\"targets\":15}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false}},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n**How to read it**\n\n- **Sheets**: *Full* has one row per compound over all batches (average and median of the measured\n  values, the curve used per batch); then one sheet per batch with its limits, statistics, model\n  and **Notes**, the full text of the note icons of table 4.2.\n- **Statistics** (minimum, maximum, average, median) use the measured values of the study samples\n  only: values replaced by the LOD/LLOQ rules are left out.\n- **Coloured cells** in the sample columns are values that were replaced or are above the ULOQ;\n  the last sheet, *Legend*, explains the colours:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"datatables html-widget html-fill-item\" id=\"htmlwidget-e9e7a0e1f5d135c9a71b\" style=\"width:100%;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-e9e7a0e1f5d135c9a71b\">{\"x\":{\"filter\":\"none\",\"vertical\":false,\"data\":[[\"\",\"\",\"\",\"\",\"\"],[\"Not detected (signal below the LOD signal): replaced by LLOQ/4\",\"Detected, not quantified (signal from the LOD signal to below the mean signal of the LLOQ level): replaced by LLOQ/2\",\"Signal at or above the LLOQ level, concentration below the LLOQ: set to the LLOQ\",\"Above the ULOQ (the top of the linear range), within the curve (not replaced)\",\"Above the ULOQ and the highest calibration level of the curve: extrapolated (not replaced)\"]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Colour<\\/th>\\n      <th>Meaning<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"ordering\":false,\"columnDefs\":[{\"name\":\"Colour\",\"targets\":0},{\"name\":\"Meaning\",\"targets\":1}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false,\"rowCallback\":\"function(row, data, displayNum, displayIndex, dataIndex) {\\nvar value=data[0]; $(this.api().cell(row, 0).node()).css({'background-color':$.inArray(dataIndex + 1, [1]) >= 0 ? \\\"#FAAFAF\\\" : $.inArray(dataIndex + 1, [2]) >= 0 ? \\\"#FCEACF\\\" : $.inArray(dataIndex + 1, [3]) >= 0 ? \\\"#D3EBF2\\\" : $.inArray(dataIndex + 1, [4]) >= 0 ? \\\"#E3E0B8\\\" : $.inArray(dataIndex + 1, [5]) >= 0 ? \\\"#A8A05A\\\" : null});\\n}\"}},\"evals\":[\"options.rowCallback\"],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n::: {.callout-tip}\n## Reuse the processing\nSave the settings with **Download settings (.yml)** on page 1. Loading the file later, in the app or\nwith `run_quanta.R` on the command line, processes new data the same way.\n:::\n",
