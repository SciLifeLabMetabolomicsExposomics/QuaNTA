\",\"0.912\",\"0.987\",\"0.934\",\"0.907\",\"0.939\",\"0.928\",\"0.917\",\"0.931\",\"0.923\",\"0.917\",\"0.928\",\"0.999\",\"0.883\",\"0.917\",\"0.951\",\"0.996\"],[\"linear-1\",\"linear-1\",\"linear-1/x\",\"quadratic-1/x\",\"linear-1\",\"linear-1\",\"linear-1\",\"quadratic-1/x\",\"linear-1/x\",\"linear-1/x2\",\"linear-1/x\",\"linear-1\",\"linear-1/x\",\"linear-1/x\",\"linear-1/x\",\"linear-1\",\"linear-1/x\",\"linear-1/x\",\"linear-1\",\"quadratic-1/x\",\"linear-1\",\"linear-1/x\",\"linear-1/x\",\"linear-1/x\",\"linear-1\"],[\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\",\"Batch\"],[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"],[\"5.564\",\"3.886\",\"2.5\",\"4.334\",\"5.453\",\"4.166\",\"4.211\",\"5.456\",\"5\",\"2.5\",\"5.612\",\"5.518\",\"5.939\",\"4.359\",\"4.651\",\"5.477\",\"4.404\",\"4.936\",\"4.27\",\"4.182\",\"4.875\",\"4.293\",\"2.5\",\"2.5\",\"4.815\"],[\"8.363\",\"9.087\",\"7.074\",\"7.267\",\"7.53\",\"8.237\",\"10.984\",\"9.706\",\"5\",\"7.096\",\"9.746\",\"9.245\",\"8.609\",\"8.122\",\"10.084\",\"9.168\",\"9.133\",\"8.957\",\"8.317\",\"8.224\",\"9.579\",\"6.779\",\"7.376\",\"7.918\",\"9.886\"],[\"16.704\",\"16.89\",\"15.114\",\"16.867\",\"16.028\",\"17.543\",\"20.083\",\"16.993\",\"17.588\",\"20.315\",\"17.259\",\"20.268\",\"15.526\",\"17.52\",\"23.474\",\"22.283\",\"15.429\",\"16.591\",\"16.872\",\"14.478\",\"19.661\",\"17.861\",\"16.197\",\"18.119\",\"18.896\"],[\"36.876\",\"39.831\",\"38.19\",\"29.804\",\"38.865\",\"39.212\",\"42.507\",\"43.852\",\"36.687\",\"34.819\",\"44.128\",\"40.3\",\"29.022\",\"38.123\",\"36.164\",\"37.655\",\"35.385\",\"31.369\",\"38.717\",\"28.974\",\"48.731\",\"30.903\",\"37.659\",\"42.264\",\"53.661\"]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Chemical<\\/th>\\n      <th>LOD<\\/th>\\n      <th>LLOQ<\\/th>\\n      <th>ULOQ<\\/th>\\n      <th>Min Conc.<\\/th>\\n      <th>Max Conc.<\\/th>\\n      <th>Avg. Conc.<\\/th>\\n      <th>Median Conc.<\\/th>\\n      <th>R2<\\/th>\\n      <th>Model<\\/th>\\n      <th>Calibration<\\/th>\\n      <th>Notes<\\/th>\\n      <th>Cal5_E_B1_95<\\/th>\\n      <th>Cal10_E_B1_96<\\/th>\\n      <th>Cal20_E_B1_97<\\/th>\\n      <th>Cal50_E_B1_98<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"scrollX\":true,\"scrollY\":\"380px\",\"scrollCollapse\":true,\"columnDefs\":[{\"className\":\"dt-center\",\"targets\":\"_all\"},{\"name\":\"Chemical\",\"targets\":0},{\"name\":\"LOD\",\"targets\":1},{\"name\":\"LLOQ\",\"targets\":2},{\"name\":\"ULOQ\",\"targets\":3},{\"name\":\"Min Conc.\",\"targets\":4},{\"name\":\"Max Conc.\",\"targets\":5},{\"name\":\"Avg. Conc.\",\"targets\":6},{\"name\":\"Median Conc.\",\"targets\":7},{\"name\":\"R2\",\"targets\":8},{\"name\":\"Model\",\"targets\":9},{\"name\":\"Calibration\",\"targets\":10},{\"name\":\"Notes\",\"targets\":11},{\"name\":\"Cal5_E_B1_95\",\"targets\":12},{\"name\":\"Cal10_E_B1_96\",\"targets\":13},{\"name\":\"Cal20_E_B1_97\",\"targets\":14},{\"name\":\"Cal50_E_B1_98\",\"targets\":15}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false}},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n**How to read it**\n\n- **Sheets**: *Full* has one row per compound over all batches (minimum, maximum, average and\n  median of the measured values of all batches together, the curve used per batch, and the notes\n  of the batches, batches with the same note together); then one sheet per batch with its limits,\n  statistics, model and **Notes**, the full text of the note icons of table 4.1.\n- **Statistics** (minimum, maximum, average, median) use the measured values of the study samples\n  only: values replaced by the LOD/LLOQ rules are left out.\n- **Coloured cells** in the sample columns are values that were replaced, are above the ULOQ, or\n  are capped at the peak of a quadratic curve (the peak is given as \"Capped upper conc\" in the\n  Slope column, \"No cap\" for quadratic curves without one); the last sheet, *Legend*, explains the\n  colours:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"datatables html-widget html-fill-item\" id=\"htmlwidget-0c1a1841317534d04d4d\" style=\"width:100%;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-0c1a1841317534d04d4d\">{\"x\":{\"filter\":\"none\",\"vertical\":false,\"data\":[[\"\",\"\",\"\",\"\",\"\",\"\"],[\"Not detected (signal below the LOD signal): replaced by LLOQ/4\",\"Detected, not quantified (signal from the LOD signal to below the mean signal of the LLOQ level): replaced by LLOQ/2\",\"Signal at or above the LLOQ level, concentration below the LLOQ: set to the LLOQ\",\"Above the ULOQ (the top of the linear range), within the curve (not replaced)\",\"Above the ULOQ and the highest calibration level of the curve: extrapolated (not replaced)\",null]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Colour<\\/th>\\n      <th>Meaning<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"dom\":\"t\",\"paging\":false,\"ordering\":false,\"columnDefs\":[{\"name\":\"Colour\",\"targets\":0},{\"name\":\"Meaning\",\"targets\":1}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false,\"rowCallback\":\"function(row, data, displayNum, displayIndex, dataIndex) {\\nvar value=data[0]; $(this.api().cell(row, 0).node()).css({'background-color':$.inArray(dataIndex + 1, [1]) >= 0 ? \\\"#FAAFAF\\\" : $.inArray(dataIndex + 1, [2]) >= 0 ? \\\"#FCEACF\\\" : $.inArray(dataIndex + 1, [3]) >= 0 ? \\\"#D3EBF2\\\" : $.inArray(dataIndex + 1, [4]) >= 0 ? \\\"#E0E0E0\\\" : $.inArray(dataIndex + 1, [5]) >= 0 ? \\\"#9E9E9E\\\" : $.inArray(dataIndex + 1, [6]) >= 0 ? \\\"#D9CFBF\\\" : null});\\n}\"}},\"evals\":[\"options.rowCallback\"],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n## Processing history\n\nSome steps of the processing cannot always be done the usual way, for example a batch without blank\nsamples or a compound without a valid calibration curve in its batch. QuaNTA then uses a\n**fallback** (e.g. the blank of all batches, or the global curve) and logs it, as it logs every\nfeature and sample it removes. The same log is shown in three places:\n\n- **In the app**, page 1, the tab *Processing history* next to the processing log: the fallbacks\n  and removals of each step, and the full feature and sample tables in a popup.\n- **In the internal report**, section 1.1, the tabs *Feature flow* (where the features ended),\n  *Fallbacks and removals*, *Feature history* and *Sample history*.\n- **In the exported tables**, the file `….history.xlsx` (each sheet also as a `.csv` file).\n\n\n::: {.cell}\n\n:::\n\n\nThe feature history of the example (QuaNTA_example_ESIpos.mvis.history.xlsx), a few targeted compounds:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"datatables html-widget html-fill-item\" id=\"htmlwidget-88655e342ad73b23caed\" style=\"width:100%;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-88655e342ad73b23caed\">{\"x\":{\"filter\":\"none\",\"vertical\":false,\"data\":[[\"(+)-Nootkatone\",\"1,3-benzothiazole\",\"1,3-Di-o-tolylguanidine\",\"1,3-Diphenylguanidine\",\"1H-Benzimidazole\",\"1H-Benzotriazole\",\"1-Methyl-1H-benzotriazole\",\"2-Hydroxybenzimidazole\",\"3'-Hydroxycotinine\",\"4- &amp; 5-Methyl-1H-benzotriazole\",\"4-(Methylnitrosamino)-1-(3-pyridyl)-1-butanol\",\"4-Methyl Hippuric Acid\",\"5,6-Dimethylbenzimidazole\",\"Aminocaproic acid\",\"Amoxicillin\",\"Arnicolide C\",\"Atenolol\",\"Atorvastatin\",\"Atrazine\",\"Atrazine desethyl\",\"Atrazine desethyl-2-hydroxy\",\"Atrazine desisopropyl\",\"Atrazine-2-hydroxy\",\"Benodanil\",\"Benzenesulfonamide\"],[16572,5569,19717,15351,4330,4395,5433,5510,12539,5435,15027,12644,6785,5299,43438,37469,24441,78009,16038,11806,9367,9893,13289,34998,7847],[\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\",\"Targeted\"],[13.016,9.436999999999999,8.393000000000001,7.449,5.343,7.041,7.653,6.794,5.164,8.625999999999999,6.263,6.625,8.836,2.048,2.874,10.645,5.299,11.648,10.847,8.613,5.06,7.192,8.956,10.659,10.53],[219.17401,136.02139,240.14929,212.11803,119.06017,120.05536,134.07094,135.05501,193.09694,134.07097,210.12367,194.08105,147.09146,132.10159,366.11121,335.18475,267.17007,559.25891,216.10056,188.06958,170.10332,174.05382,198.13458,323.98737,158.0269],[\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Not quantified\",\"Quantified\",\"Removed (blank filter)\",\"Quantified\",\"Not quantified\",\"Not quantified\",\"Quantified\",\"Removed (blank filter)\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\",\"Quantified\"],[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"],[\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\",\"PCA of the IS\"],[\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Passed\",\"Removed: Study sample maximum 3.23 ×