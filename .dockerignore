# Files Docker does not send to the build. The Dockerfile only uses app/ (including app/envs/),
# renv.lock and docker/; everything else would slow the build down or end up in the image.

# Version control, CI and editor / R session files
.git
.github
.claude
.Rproj.user
**/.RData
**/.Rhistory
**/*.Rproj

# Test and example data, design mockups (example_data is linked from the app, not served by it)
test_data
mockups
example_data

# Quarto's cache and reports rendered during development (the app renders its reports in a
# private copy of app/reports and leaves the cache out)
app/reports/.quarto
app/reports/*.html
app/reports/*.pdf
app/reports/*_files
